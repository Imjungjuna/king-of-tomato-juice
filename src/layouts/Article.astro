---
const { title } = Astro.props;
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="" />
    <meta name="keywords" content="" />
    <meta name="google-site-verification" content="gziptz26SZQsPwx4P4IMxZ-Xw_6u3bYSXAZFQg-tnHg" />
    <style>
      body { font-family: Roboto, "Open Sans", Arial, sans-serif; line-height: 1.7; color: #333; margin: 0; }
      header, main, footer { max-width: 900px; margin: 0 auto; padding: 0 20px; }
      header ul { list-style: none; display: flex; gap: 24px; padding: 20px 0; margin: 0; font-size: 0.85rem; font-weight: 700; }
      header a, footer a { color: #333; text-decoration: none; }
      h1 { font-size: 2rem; line-height: 1.3; margin-top: 40px; }
      h2 { font-size: 1.4rem; margin-top: 2rem; }
      footer { margin-top: 60px; padding: 30px 20px; border-top: 1px solid #eee; font-size: 0.85rem; color: #777; }
      footer ul { list-style: none; padding: 0; }
    </style>
  </head>
  <body>
    <header>
      <ul>
        <li><a href="/">HOME</a></li>
        <li><a href="/">ABOUT</a></li>
        <li><a href="/">FEATURES</a></li>
        <li><a href="/">CONTACT</a></li>
      </ul>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <h4>FOR READERS</h4>
      <ul>
        <li><a href="/">Tasting Notes</a></li>
        <li><a href="/">Frequently Asked Questions</a></li>
      </ul>
      <h4>FOR MEDIA</h4>
      <ul>
        <li><a href="/">About</a></li>
        <li><a href="/">Contact</a></li>
      </ul>
      <p>Copyright © 2026 - The King of Tomato Juice</p>
    </footer>
  </body>
</html>
